# Docs site build artifacts, all regenerated by
# .github/scripts/build-site.py. None of these is hand-edited.
# .site-src/ is the staged markdown tree, mkdocs.generated.yml is
# mkdocs.yml plus the generated nav, site/ is the rendered HTML,
# and .venv-docs/ is the local toolchain virtualenv.
# Anchored with a leading slash: an unanchored `site/` would also swallow
# .github/site/, which holds the site's stylesheet and is tracked.
/.site-src/
/mkdocs.generated.yml
/site/
/.venv-docs/
